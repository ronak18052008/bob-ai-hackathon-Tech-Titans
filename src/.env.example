# MedBrief Environment Variables

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================

# Determines if the frontend should run in demonstration mode using synthetic data.
# Set to 'true' to safely run the app without real patient data or backend dependencies.
VITE_DEMO_MODE=true

# ==============================================================================
# IBM WATSONX / MCP SERVER CONFIGURATION
# ==============================================================================

# Your IBM Cloud API key for authenticating with watsonx.ai (Never commit the real key)
IBM_CLOUD_API_KEY=dummy-api-key-for-local-testing

# The watsonx project ID
WATSONX_PROJECT_ID=dummy-project-id-1234

# Endpoint URL for watsonx (depends on your region)
WATSONX_URL=https://us-south.ml.cloud.ibm.com
