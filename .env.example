# MedSynapse AI — Environment Configuration
# NEVER commit real credentials, production API keys, or patient data.

# Application Environment
NODE_ENV=production
APP_ENV=demo
PORT=8000
FRONTEND_PORT=3000

# Database Configuration
DATABASE_URL=sqlite:///medsynapse.db

# IBM watsonx.ai Integration
WATSONX_API_KEY=DEMO_WATSONX_API_KEY
WATSONX_PROJECT_ID=DEMO_PROJECT_ID
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Security & Multi-Factor Auth Secret
JWT_SECRET=demo-secret-key-change-in-production-only-medsynapse-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Logging & Audit Configuration
AUDIT_LOG_ENABLED=true
LOG_LEVEL=INFO
